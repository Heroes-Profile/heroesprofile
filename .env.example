APP_NAME=HeroesProfile
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

HEROESPROFILE_DB_CONNECTION=heroesprofile
HEROESPROFILE_DB_HOST=
HEROESPROFILE_DB_HOST_LOCAL=
HEROESPROFILE_DB_PORT=
HEROESPROFILE_DB_DATABASE=heroesprofile
HEROESPROFILE_DB_DATABASE_API=heroesprofile_api
HEROESPROFILE_DB_DATABASE_GLOBALS=heroesprofile_globals
HEROESPROFILE_DB_DATABASE_NGS=heroesprofile_ngs
HEROESPROFILE_DB_DATABASE_NGS_DEV=heroesprofile_ngs_dev
HEROESPROFILE_DB_DATABASE_CCL=heroesprofile_ccl
HEROESPROFILE_DB_DATABASE_MCL=heroesprofile_mcl
HEROESPROFILE_DB_DATABASE_HI=heroesprofile_hi
HEROESPROFILE_DB_DATABASE_HI_NC=heroesprofile_hi_nc
HEROESPROFILE_DB_DATABASE_HGC_MORE=heroesprofile_ml
HEROESPROFILE_DB_LOGGING_DATABASE=heroesprofile_logs
HEROESPROFILE_DB_CACHE_DATABASE=heroesprofile_cache
HEROESPROFILE_DB_USERNAME=
HEROESPROFILE_DB_PASSWORD=
HEROESPROFILE_DB_CACHE_TABLE=cache

# Cashier / Stripe — billing for API accounts
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
# Emails the customer when a renewal needs bank confirmation (SCA). Without it
# Cashier's invoice.payment_action_required handler exits silently and the key
# just stops working.
CASHIER_PAYMENT_NOTIFICATION=Laravel\Cashier\Notifications\ConfirmPayment
# Stripe Price object IDs (not amounts) — Stripe holds the amounts
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_INTERMEDIATE=
STRIPE_PRICE_ID_DEVELOPER=

BATTLENET_KEY=
BATTLENET_SECRET=
BATTLENET_REDIRECT_URI=

PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REDIRECT_URI=
PATREON_CAMPAIGN_ID=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=

BROADCAST_DRIVER=log
CACHE_DRIVER=database
CACHE_PREFIX=

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

GLOBAL_ASYNC_ENABLED=false
GLOBAL_BYPASS_CACHE=false
CLOUD_TASKS_PROJECT_ID=
CLOUD_TASKS_LOCATION=us-east1
CLOUD_TASKS_QUEUE=global-queries
CLOUD_TASKS_HANDLER_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=

SESSION_DRIVER=file
SESSION_CONNECTION=
SESSION_LIFETIME=250
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

VITE_APP_NAME="${APP_NAME}"
ASSET_URL=/

GITHUB_PERSONAL_ACCESS_TOKEN=
FLARE_KEY=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
PHP_MAX_EXECUTION_TIME=300


GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=

# Local development only. Path to a service-account JSON key, kept outside this
# repository. Leave empty everywhere else: Cloud Run authenticates through the
# metadata server, and an empty value falls through to it.
GOOGLE_CLOUD_KEY_FILE=

# Replay parser Cloud Run service. Must match the service URL exactly — it is the
# audience the ID token is minted for.
REPLAY_PARSER_URL=
GOOGLE_CLOUD_NGS_BUCKET=heroesprofile-ngs

# Test suite only. Every connection points at the local test container
# (docker-compose/docker-compose.testing.yaml); tests/TestCase.php refuses anything else.
APP_NAME="Heroes Profile"
APP_ENV=testing
APP_KEY=base64:h8tJeN1U9OR/y/cQ46TtUpboixyciBIdCd7w+y8DiYk=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=null
LOG_LEVEL=debug

HEROESPROFILE_DB_CONNECTION=heroesprofile
HEROESPROFILE_DB_HOST=127.0.0.1
HEROESPROFILE_DB_PORT=33061
HEROESPROFILE_DB_USERNAME=root
HEROESPROFILE_DB_PASSWORD=testing

# Laravel 11 merges its own default connections (mysql, mariadb) into config/database.php. Unused, but they read
# DB_*, so they point at the test container too and the local-only guard holds for every connection.
DB_HOST=127.0.0.1
DB_PORT=33061
DB_DATABASE=heroesprofile
DB_USERNAME=root
DB_PASSWORD=testing
MYSQL_ATTR_SSL_CA=
HEROESPROFILE_DB_DATABASE=heroesprofile
HEROESPROFILE_DB_DATABASE_API=heroesprofile_api
HEROESPROFILE_DB_DATABASE_PROCESSING=heroesprofile_processing
HEROESPROFILE_DB_DATABASE_POLLS=heroesprofile_polls
HEROESPROFILE_DB_DATABASE_GLOBALS=heroesprofile_globals
HEROESPROFILE_DB_DATABASE_NGS=heroesprofile_ngs
HEROESPROFILE_DB_DATABASE_NGS_DEV=heroesprofile_ngs_dev
HEROESPROFILE_DB_DATABASE_CCL=heroesprofile_ccl
HEROESPROFILE_DB_DATABASE_MCL=heroesprofile_mcl
HEROESPROFILE_DB_DATABASE_HI=heroesprofile_hi
HEROESPROFILE_DB_DATABASE_HI_NC=heroesprofile_hi_nc
HEROESPROFILE_DB_DATABASE_HGC_MORE=heroesprofile_ml
HEROESPROFILE_DB_DATABASE_TRANSLATIONS=heroesprofile_translations
HEROESPROFILE_DB_CACHE_DATABASE=heroesprofile_cache
HEROESPROFILE_DB_LOGGING_DATABASE=heroesprofile_logs
HEROESPROFILE_DB_CACHE_TABLE=cache

CACHE_DRIVER=array
USE_CACHE_LOCALLY=false
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local

GLOBAL_ASYNC_ENABLED=false
GLOBAL_BYPASS_CACHE=true

# External services stay blank; tests fake them
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
BATTLENET_KEY=
BATTLENET_SECRET=
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
CLOUD_TASKS_PROJECT_ID=
CLOUD_TASKS_HANDLER_URL=
DEEP_ANALYTICS_SERVICE_URL=
FLARE_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_KEY_FILE=
REPLAY_PARSER_URL=
HEROESPROFILE_CHAT_ANTHROPIC_API_KEY=
TWITCH_EXTENSION_CLIENT_ID=
TWITCH_EXTENSION_SECRETS=
TWITCH_PUBLIC_ENABLED=false
